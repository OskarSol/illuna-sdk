{
  "name": "@illuna/sdk",
  "version": "0.1.0",
  "description": "Page-scoped UI adaptation for React with server-side validation and optional SQLite persistence",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/OskarSol/illuna-sdk.git" },
  "engines": { "node": ">=24.0.0" },
  "files": ["dist", "docs", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./storage/sqlite": { "types": "./dist/storage/sqlite.d.ts", "import": "./dist/storage/sqlite.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.2.0",
    "typescript": "~5.9.3"
  }
}
